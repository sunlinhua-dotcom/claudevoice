# cc-bridge config. Copy to bridge/.env and fill in. Never commit .env.
# Full guide: docs/CONFIGURATION.md ("cc-bridge") and bridge/README.md.

# --- Feishu app (required) ---------------------------------------------------
# Self-built enterprise app with a bot, event subscription over LONG CONNECTION,
# events im.message.receive_v1 + card callback card.action.trigger.
# Only ONE process may hold the long connection of a given app.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx
# open_id (ou_...) of the one person allowed to drive the bridge. Everyone else is refused.
LARK_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# --- Local approval service (Claude tool-permission cards) --------------------
# Loopback port of the approval HTTP service used by the MCP child process.
CC_APPROVAL_PORT=18791
# Random token (>= 32 bytes) the MCP child must present. Generate: openssl rand -hex 32
CC_APPROVAL_TOKEN=replace-with-a-long-random-string
# How long to wait for you to tap allow/deny before auto-denying (ms, default 10 min).
CC_APPROVAL_TIMEOUT_MS=600000
# 1 = auto-allow read-only tools and a conservative read-only Bash allowlist; 0 = card for everything.
CC_AUTO_ALLOW_READONLY=1
# How long ask_user waits for your choice (ms, default 15 min).
CC_ASK_TIMEOUT_MS=900000
# Max active run time of one Claude turn (ms, default 45 min; approval waits are excluded).
CC_TASK_TIMEOUT_MS=2700000
# Global concurrency (each project runs at most one task).
CC_GLOBAL_LIMIT=3
# Minimum interval between PATCHes of one task card (ms, hard floor 2500).
CC_CARD_THROTTLE_MS=2500
# 1 = send files mentioned in a finished result back to the chat (max 3); 0 = off.
CC_SEND_FILES=1
# Where project directories are auto-discovered (each sub-directory becomes a project).
# Default: ~/Projects. Explicit projects go in bridge/projects.json (see projects.example.json).
# CC_WORKSPACE_ROOT=/absolute/path/to/your/projects
# Legacy media directory still auto-allowed for Read/Glob (default ~/.claude/cc-bridge-tmp). New media lives in <project>/.cc-bridge/incoming/.
# CC_TMP_DIR=
# ffmpeg binary for voice messages (default: looked up on PATH).
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# --- Session links (optional, needs a CloudCLI-style web UI) -------------------
# Base URL of your own Claude Code web UI (siteboon/claudecodeui, see docs/CONFIGURATION.md section 9).
# Cards then get an "open cockpit" button and /sessions lists <CC_WEB_URL>/session/<id>.
# Leave unset to disable: no button, no link lines.
# CC_WEB_URL=https://cc.example.com

# --- ClaudeVoice Worker lifecycle events (optional; silent on failure) ---------
# Your deployed Worker's hook endpoint and the same shared secret as HOOK_SECRET in the root .env.
# `npm run env:sync-worker` copies HOOK_SECRET from the root .env for you.
CV_WORKER_URL=https://claudevoice.your-subdomain.workers.dev/hook
HOOK_SECRET=same-value-as-the-root-.env

# --- Remote input into the Mac (optional) ---------------------------------------
# "Input mode" types/pastes what you say into the frontmost Mac window through the Worker's
# /ws relay and ClaudeVoice.app. Leave empty to run in task-only mode.
# RELAY_URL: your Worker, with wss:// and /ws, e.g. wss://claudevoice.your-subdomain.workers.dev/ws
# MAC_ID: shown by the Mac app (menu bar > pairing) or `defaults read com.claudevoice.app rv.macId`
RELAY_URL=wss://claudevoice.your-subdomain.workers.dev/ws
MAC_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DEVICE_NAME=Claude Feishu bridge
