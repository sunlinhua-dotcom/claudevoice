# ClaudeVoice 配置（复制为 .env 后填写）
PORT=8787
HOST=0.0.0.0

# ── TTS 引擎（edge → 配了 key 才有 azure 兜底）──
# edge = 微软 Edge 神经语音：免 key、免费（默认首选，无需任何注册）
TTS_ENGINE=edge
TTS_VOICE=茉莉

# Azure 语音服务（可选兜底；与 edge 同一套语音名）
# 注册 Azure → 建 Speech 资源 → 拿 key 和区域（如 eastasia / eastus）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# 子任务完成（SubagentStop）：silent=只在面板显示不出声不推送(默认) / voice=像完成一样播报 / off=完全忽略
CV_SUBAGENT=silent

# 播报时尊称你的名字
USER_NAME=Dev

# hook → 服务的共享密钥；运行 setup.js 会自动生成，勿手填
HOOK_SECRET=

# 放公网时建议设一个随机串，面板/接口需 ?token=该串 才能访问；本机用可留空
DASH_TOKEN=

# 飞书推送（本机即可推到手机飞书，无需云端）：
# 方式一（推荐，机器人私信）：飞书自建应用的 App ID/Secret + 你的 open_id。
#   需开通权限 im:message 和 contact:user.id:readonly。
LARK_APP_ID=
LARK_APP_SECRET=
LARK_OPEN_ID=
# 方式二（备选，群自定义机器人）：填 webhook，私信用方式一即可忽略这两个。
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
