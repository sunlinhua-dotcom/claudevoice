# ClaudeVoice local server config. `node setup.js` creates a working .env for you;
# copy this file to .env only if you prefer to fill it in by hand.
# (The local server is optional - the Cloudflare Worker reads the same names as secrets.)

# Local server listen address. HOST defaults to 0.0.0.0 (all interfaces); use 127.0.0.1 to keep it local-only.
PORT=8787
HOST=127.0.0.1

# TTS engine: edge = Microsoft Edge neural voices, free, no key (default).
TTS_ENGINE=edge
# Default voice, one of the four built-in display voices: 茉莉 / 白桦 / 冰糖 / 苏打.
TTS_VOICE=茉莉

# Optional Azure Speech fallback (same voice names as edge). Leave empty to disable.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Sub-agent completion (SubagentStop): silent = panel only, no sound/push (default); voice = announce; off = ignore.
CV_SUBAGENT=silent

# The name used in spoken alerts, and optional comma-separated alternatives rotated at random.
USER_NAME=Dev
USER_ALIASES=

# Shared secret between hook.js / the Mac app and the server. setup.js generates it - do not reuse across machines.
HOOK_SECRET=

# Set a random string before exposing the panel publicly; the panel and API then require ?token=<this>.
DASH_TOKEN=

# Public panel URL put on the "open panel" button of Feishu cards (optional).
DASH_URL=

# Feishu push straight from the local server (no Worker needed).
# Option 1 (recommended, bot DM): self-built app credentials + your open_id.
#   Needs the im:message and contact:user.id:readonly scopes.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_OPEN_ID=
# Option 2 (fallback): group custom-bot webhook (+ optional signing secret).
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=

# Optional: base URL of your self-hosted Claude Code web UI (CloudCLI). `node setup.js` asks for it.
# Recorded for reference; the hook reads webUrl from ~/.claude/claudevoice.json and cc-bridge reads bridge/.env.
# See docs/CONFIGURATION.md section 9. Leave empty = no web links anywhere.
CC_WEB_URL=
