{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(npm test:*)",
      "Bash(pm2 status)",
      "Bash(pm2 jlist)",
      "Bash(pm2 logs:*)",
      "Bash(npx wrangler deploy --dry-run:*)"
    ],
    "ask": [
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler secret:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pm2 restart:*)",
      "Bash(pm2 stop:*)"
    ],
    "deny": [
      "Bash(npm start)",
      "Bash(node server.js:*)",
      "Read(./.env)",
      "Read(./bridge/.env)",
      "Read(./cloudflare/.dev.vars)"
    ]
  }
}
