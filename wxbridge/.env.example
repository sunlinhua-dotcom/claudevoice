# wxbridge settings. wxbridge reads plain environment variables (no .env loader):
# export them before starting, or put them in a PM2 ecosystem file:
#   set -a; . wxbridge/.env; set +a; pm2 start wxbridge/start.mjs --name wxbridge --time
# Every variable is optional.

# Only serve this one WeChat user id (default: the first person who talks to the bot).
# WXBRIDGE_OWNER=

# Which account id to use from the fallback login above (default: the first one listed).
# WXBRIDGE_ACCOUNT=

# Folder created inside each project for incoming files (default _inbox).
# WXBRIDGE_INBOX_DIR=_inbox
# Where files whose project could not be determined are parked (default ~/.wxbridge/_unsorted).
# WXBRIDGE_UNSORTED_DIR=
# Cursor / learned keywords / last-batch state (default ~/.wxbridge).
# WXBRIDGE_STATE_DIR=
# How long "switch to <project>" stays active, ms (default 1800000 = 30 min).
# WXBRIDGE_STICKY_TTL_MS=1800000
# Plain-text messages shorter than this are not filed, only answered (default 12).
# WXBRIDGE_MIN_BRIEF_CHARS=12

# Optional LLM fallback for deciding the project from the content. Any OpenAI-compatible
# /v1/chat/completions endpoint. Unset = no model guess, unknown briefs go to _unsorted.
# WXBRIDGE_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# WXBRIDGE_MODEL=your-model-name
# WXBRIDGE_MODEL_KEY=

# Fallback login: if ~/.wxbridge/account.json is missing, wxbridge reuses a login left behind by
# Tencent's official OpenClaw WeChat plugin, looked up under <this dir>/openclaw-weixin/accounts/.
# Default ~/.openclaw. Normally you just run `node login.mjs` and never need this.
# WXBRIDGE_OPENCLAW_HOME=
